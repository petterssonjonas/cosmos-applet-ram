<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.cosmic-ram-applet</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <name>RAM Usage</name>
  <summary>Show used RAM in GB on the COSMIC panel</summary>
  <description>
    <p>Displays a RAM icon followed by used system memory in whole GB on the COSMIC panel. The value refreshes every two seconds.</p>
  </description>
  <launchable type="desktop-id">io.github.cosmic-ram-applet.desktop</launchable>
  <provides>
    <id>com.system76.CosmicApplet</id>
    <binary>cosmic-ram-applet</binary>
  </provides>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <categories>
    <category>System</category>
  </categories>
  <keywords>
    <keyword>COSMIC</keyword>
  </keywords>
  <content_rating type="oars-1.1" />
</component>
